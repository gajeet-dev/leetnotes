{% macro bullets(items) -%}
    {%- if items -%}
        {{ "- " ~ items | join("\n- ") }}
    {%- else -%}
        -
    {%- endif -%}
{% endmacro -%}
{% macro approach_body(a) %}
**Core idea:**
{{ bullets(a.core_idea) }}

**Trap:**
{{ bullets(a.trap) }}

**Complexity:**
- Time: `{{ a.complexity_time or 'O(?)' }}`
- Space: `{{ a.complexity_space or 'O(?)' }}`
{% endmacro %}
---
id: {{ frontend_id }}
slug: {{ slug }}
aliases: [{% for a in aliases %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}]
tags:
{% for t in tags %}
 - {{ t }}
{% endfor %}
difficulty: {{ difficulty }}
platform: LeetCode
problem_link: "{{ url }}"
{% if related %}
related:
{% for r in related %}
 - "[[{{ r }}]]"
{% endfor %}
{% endif %}
---
# {{ frontend_id }}. {{ title }}
### 🔗 **Problem & Solution:** [[{{ problem_note }}|Link]]

**Problem:**
> {{ problem_summary or '' }}

**Recognition clue:**
{{ bullets(recognition_clue) }}

{% if approaches | length > 1 %}
## Approaches

{% for a in approaches %}
### {{ loop.index }}. {{ a.name }}{% if a.code_ref %} (`{{ a.code_ref }}`){% endif %}

{{ approach_body(a) }}

{% endfor %}
**Comparison:**

| Approach | Time | Space | Pick when |
|---|---|---|---|
{% for a in approaches %}
| {{ a.name }} | `{{ a.complexity_time or '?' }}` | `{{ a.complexity_space or '?' }}` | {{ a.pick_when or '' }} |
{% endfor %}
{% else %}
{{ approach_body(approaches[0]) }}
{% endif %}

