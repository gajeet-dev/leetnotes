{
  "default": "claude",
  "providers": {
    "claude": {
      "type": "cli",
      "command": [
        "fcc-claude",
        "-p",
        "--output-format",
        "json",
        "--model",
        "{model}",
        "--safe-mode",
        "--disallowedTools",
        "Bash Read Write Edit Glob Grep WebFetch WebSearch NotebookEdit Task"
      ],
      "model": "sonnet",
      "system_prompt_flag": "--system-prompt",
      "prompt_via": "stdin",
      "envelope_key": "result",
      "timeout": 300
    },
    "agy": {
      "type": "cli",
      "command": ["agy", "-p", "{prompt}", "--print-timeout", "5m"],
      "prompt_via": "arg",
      "timeout": 330
    }
  }
}
